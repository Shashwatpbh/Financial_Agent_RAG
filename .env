# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Google Custom Search ──────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── Alpha Vantage ─────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=VQ7ZFPJMV6XHPLCC
ALPHA_VANTAGE_SOURCE=https://www.alphavantage.co/query?

# ── Vector DB ─────────────────────────────────────────────────────────────────
VECTOR_DB_TYPE=chromadb
CHROMADB_PERSIST_DIRECTORY=./data/chroma_db
CHROMADB_COLLECTION_NAME=financial_docs

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_EMBEDDING_MODEL=nomic-embed-text

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_LLM_MODEL=qwen2.5:latest
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=10
AGENT_SYSTEM_PROMPT="MANDATORY: For ANY company question, execute IN ORDER: 1) FIRST call symbol_search(company_name) - DO NOT SKIP. 2) Use ticker from step 1 to call query_chromadb. 3) If empty, call income_statement, cash_flow, balance_sheet, shares_outstanding. 4) Analyze and respond. NEVER assume ticker symbols."

# ── API ───────────────────────────────────────────────────────────────────────
API_SERVICE_TITLE="Sample APP"
API_VERSION="0.0.1"
API_HOST=0.0.0.0
API_PORT=8081
API_WORKERS=4

# ── MCP ──────────────────────────────────────────────────────────────────────
MCP_HOST=localhost
MCP_PORT=8082

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_JOB_TTL=3600

ENVIRONMENT=development
DEBUG=true
OBS_LOG_LEVEL=INFO
OBS_LOG_FORMAT=json 